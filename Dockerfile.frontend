# ── Stage 1: build ────────────────────────────────────────────────────────────
# Must be built from the monorepo root so workspace packages are available.
FROM node:22-alpine AS builder

RUN npm install -g pnpm@10

WORKDIR /app

# Copy workspace manifests + lock file first for better layer caching
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./

# Copy workspace packages that the frontend depends on
COPY packages/types/      ./packages/types/
COPY packages/api-client/ ./packages/api-client/

# Copy the app itself
COPY apps/frontend/ ./apps/frontend/

# Install all workspace dependencies (esbuild build approved via package.json pnpm config)
RUN pnpm install --frozen-lockfile

# Build the frontend
RUN pnpm --filter @sdai/frontend build

# ── Stage 2: serve ────────────────────────────────────────────────────────────
FROM nginx:alpine

# openssl  - generates the self-signed certificate at first start (entrypoint):
#            never at build time, or every installation made from the same
#            image would share one private key
# certbot certbot-nginx - issues and renews Let's Encrypt certificates
RUN apk add --no-cache openssl certbot certbot-nginx

# Static files from the build stage
COPY --from=builder /app/apps/frontend/dist /usr/share/nginx/html

# nginx config templates - entrypoint picks one based on HTTPS_MODE at startup
COPY apps/frontend/nginx.conf                    /etc/nginx/templates/self_signed.conf
COPY apps/frontend/nginx.letsencrypt.conf        /etc/nginx/templates/letsencrypt.conf
COPY apps/frontend/nginx.letsencrypt_pending.conf /etc/nginx/templates/letsencrypt_pending.conf

# Entrypoint writes /etc/nginx/conf.d/default.conf from the chosen template
COPY apps/frontend/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

EXPOSE 80 443

ENTRYPOINT ["/docker-entrypoint.sh"]
