# ── Auth ──────────────────────────────────────────────────────────────────────
# Users are stored in PostgreSQL (sdai_users table).
# After first boot, create the first admin with:
#   docker compose exec api python create_admin.py --email admin@example.com --password secret
AUTH_SECRET_KEY=change-me-in-production
# Set to true when running behind HTTPS (self_signed or letsencrypt mode).
# Secure cookies require HTTPS — leave false for plain HTTP local dev only.
AUTH_SECURE_COOKIES=false
AUTH_TOKEN_EXPIRE_HOURS=8

# ── HTTPS / TLS ───────────────────────────────────────────────────────────────
# HTTPS_MODE controls which certificate is used:
#   self_signed  — default; self-signed cert baked into the Docker image at build
#                  time. No configuration needed. Accept the browser warning once.
#   letsencrypt  — certbot with the nginx plugin. Requires a public domain name.
#                  Set LETSENCRYPT_DOMAIN and LETSENCRYPT_EMAIL, then run the
#                  one-time certbot command documented in README § HTTPS.
HTTPS_MODE=self_signed

# Required only when HTTPS_MODE=letsencrypt:
LETSENCRYPT_DOMAIN=
LETSENCRYPT_EMAIL=

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev:  postgresql+asyncpg://sdai:sdai@localhost:5432/sdai
# Docker:     postgresql+asyncpg://sdai:sdai@db:5432/sdai
DATABASE_URL=postgresql+asyncpg://sdai:sdai@localhost:5432/sdai

# ── Ollama ────────────────────────────────────────────────────────────────────
# Local dev:  http://localhost:11434
# Docker:     http://host.docker.internal:11434  (Ollama running on host)
OLLAMA_HOST=http://localhost:11434

# ── Storage ───────────────────────────────────────────────────────────────────
# Directory for processed images and file uploads (must be writable)
DATA_DIR=./data

# Root of the repository — used to locate documents/ for OCR/VLM endpoints.
# Set automatically to /app in Docker (via Dockerfile ENV). Override for local dev
# if running the API from a subdirectory (e.g. apps/api/).
# PROJECT_ROOT=/path/to/sdai_digitalization

# ── Redis (caching) ──────────────────────────────────────────────────────────
# Local dev:  redis://localhost:6379  (requires Redis installed locally)
# Docker:     redis://redis:6379
# Falls back to in-memory cache if unreachable — safe to leave unset for dev.
REDIS_URL=redis://localhost:6379

# ── CORS ──────────────────────────────────────────────────────────────────────
# Local dev only — leave empty in Docker (nginx proxies internally)
CORS_ORIGINS=http://localhost:5173

# ── Google Drive (optional) ───────────────────────────────────────────────────
# Path to a service account JSON key file with Drive read access.
# Required only when using POST /api/ingest/path with google_drive_folder_id.
GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/service-account.json

# OAuth2 credentials (if building a user-facing Drive connect flow in future)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
