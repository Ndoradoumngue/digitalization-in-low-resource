# ── Auth ──────────────────────────────────────────────────────────────────────
# Users are stored in PostgreSQL (sdai_users table).
# After first boot, create the first admin with:
#   docker compose exec api python create_admin.py --email admin@example.com --password secret
#
# REQUIRED - generate with: openssl rand -hex 32
AUTH_SECRET_KEY=
# Set to true when running behind HTTPS (self_signed or letsencrypt mode).
# Secure cookies require HTTPS - leave false for plain HTTP local dev only.
AUTH_SECURE_COOKIES=false
AUTH_TOKEN_EXPIRE_HOURS=8

# ── HTTPS / TLS ───────────────────────────────────────────────────────────────
# HTTPS_MODE controls which certificate is used:
#   self_signed  - default; self-signed cert baked into the Docker image at build
#                  time. No configuration needed. Accept the browser warning once.
#   letsencrypt  - certbot with the nginx plugin. Requires a public domain name.
#                  Set LETSENCRYPT_DOMAIN and LETSENCRYPT_EMAIL, then run the
#                  one-time certbot command documented in README § HTTPS.
HTTPS_MODE=self_signed

# Required only when HTTPS_MODE=letsencrypt:
LETSENCRYPT_DOMAIN=
LETSENCRYPT_EMAIL=

# ── Database ──────────────────────────────────────────────────────────────────
# REQUIRED - change POSTGRES_PASSWORD to a long random string
# Generate with: openssl rand -hex 32
POSTGRES_USER=sdai
POSTGRES_PASSWORD=
POSTGRES_DB=sdai
# Local dev:  postgresql+asyncpg://sdai:<password>@localhost:5432/sdai
# Docker:     postgresql+asyncpg://sdai:<password>@db:5432/sdai
DATABASE_URL=postgresql+asyncpg://sdai:@localhost:5432/sdai

# ── Ollama ────────────────────────────────────────────────────────────────────
# Local dev:  http://localhost:11434
# Docker:     http://host.docker.internal:11434  (Ollama running on host)
OLLAMA_HOST=http://localhost:11434

# ── VLM extraction schema (optional) ─────────────────────────────────────────
# The default prompt is tailored to government administrative
# documents. Different document corpora (invoices, lexicons, land titles...)
# need a different extraction schema - override without a code change or
# rebuild. See README.md "Customizing the extraction schema".
#
# Path to a text file containing the full prompt. Put it under documents/
# (already volume-mounted) so it survives image rebuilds.
# VLM_PROMPT_FILE=/app/documents/prompts/my_schema.txt
#
# Per-page VLM call timeout in seconds (default 120). Deliberately a
# deployment-wide setting, not a per-prompt one - how long a VLM call is
# allowed to run is a property of this deployment's hardware (CPU vs GPU,
# how fast inference actually runs here), not of any one document corpus.
# A schema that asks for a lot of output per page (e.g. a long list of
# dictionary entries) needs more generation time - raise this if pages
# are failing with "VLM timeout"; check real durations in
# `docker compose logs ollama` to size it rather than guessing.
# VLM_PAGE_TIMEOUT_SECONDS=120
#
# Ollama's context window per VLM call, in tokens (default 8192). Also
# deployment-wide, same reasoning as above - it's bounded by what this
# deployment's Ollama instance can hold in memory, not by document
# content. Left too low (Ollama's own default is 4096), the image plus
# instructions alone can eat ~2000 tokens, leaving too little room for a
# text-dense page's output to finish before the window runs out - this
# fails as an unparseable truncated response, not a timeout. Raise this
# if pages are failing with a JSON parse error rather than a timeout.
# VLM_NUM_CTX=8192
#
# Max tokens the VLM may generate per page. Stops a page whose output falls
# into a repetition loop after a few minutes (as a parse error) instead of
# running until VLM_PAGE_TIMEOUT_SECONDS. Raise it if legitimately long
# pages fail with a truncated-JSON parse error.
# VLM_NUM_PREDICT=2048
#
# Everything else about a corpus - which fields accumulate across pages,
# column-splitting - is corpus layout/schema, not deployment config, so
# it's set as directives at the top of your prompt file (VLM_PROMPT_FILE
# above), not here:
#   # list_fields: person_names, quality_issues
#   # split_page_columns: true
#   # split_from_page: 12
#   <blank line, then your actual prompt text>
# list_fields names the fields that should accumulate across pages during
# multi-page reconciliation instead of "first non-empty value wins" - must
# match the array-valued keys in your prompt's schema. split_page_columns
# splits each page down the middle before VLM extraction (for a document
# typeset in two independent side-by-side columns, e.g. a dictionary where
# each entry is self-contained within its column - NOT parallel-text
# translation, which needs both columns visible together to pair
# correctly). split_from_page narrows that to pages at or after a given
# 1-indexed scan page, for a corpus whose front matter (cover, table of
# contents, introduction...) isn't two-column.
# See documents/prompts/lexicon.txt for a real example of all three.
#
# The env vars below are the deployment-wide fallback for a tenant using
# the built-in default prompt (no prompt file to put directives in) -
# a prompt file's own directives always take precedence over these.
# VLM_LIST_FIELDS=person_names,quality_issues
# SPLIT_PAGE_COLUMNS=true
# SPLIT_FROM_PAGE=12

# ── Page text for full-text search (local node, see README) ──────────────────
# Tesseract languages to read every page with ("+"-separated; each pack must be
# installed - the API image has fra, eng and ara). Pages ingested before this
# was enabled: python scripts/backfill_page_text.py (in the api container).
# OCR_LANGS=fra+eng
# OCR_TIMEOUT_SECONDS=120
# OCR_ENABLED=true

# ── Downloads, share links, exports (GED, see README) ─────────────────────────
# Address external share links are built with - the internet-facing (cloud)
# node, e.g. https://ged.example.td. Empty = the address the request came in on.
PUBLIC_BASE_URL=
# true = PDFs of confidential/secret documents are downloaded with a watermark
# (who, when) - the archived file itself is never changed.
DOWNLOAD_WATERMARK_CONFIDENTIAL=false
# Selective exports (ZIP of originals + metadata + sha256 manifest, any user, own
# downloadable documents only): max documents and size of one export, how long
# the ZIP stays downloadable, and how many build at once on a node.
EXPORT_MAX_DOCUMENTS=500
EXPORT_MAX_MB=2048
EXPORT_LINK_HOURS=24
EXPORT_CONCURRENCY=2

# ── Storage ───────────────────────────────────────────────────────────────────
# Directory for processed images and file uploads (must be writable)
DATA_DIR=./data

# ── Node identity (hybrid local + cloud deployment, see README) ───────────────
# NODE_ID is stamped on every row this server writes (origin_node) - unique
# per server, stable over time, lowercase letters/digits/_/- (max 40 chars).
# NODE_ROLE: local = on-site primary server (with the GPU), cloud = replica.
NODE_ID=local
NODE_ROLE=local

# ── Local/cloud sync (hybrid deployment, see README) ──────────────────────────
# Both nodes need the SAME token (a long random secret: openssl rand -hex 32).
# Unset = sync disabled (the /api/sync routes answer 404, the worker idles).
SYNC_NODE_TOKEN=
# Only on the node that initiates sync - the local one, which can reach the
# cloud (the cloud can't reach a server behind the office NAT). Empty on the
# cloud node. Example: https://ged.example.td
SYNC_PEER_URL=
# Seconds between two sync cycles (backs off up to 15 min while offline).
SYNC_INTERVAL_SECONDS=30
# Bandwidth cap for sync traffic in KB/s, e.g. 256 on a shared office link. 0 = unlimited.
SYNC_MAX_KBPS=0
# Days applied sync changes are kept before being pruned.
SYNC_CHANGELOG_RETENTION_DAYS=30
# The admin Synchronisation page raises an alert after this many hours without a successful sync.
SYNC_ALERT_HOURS=6

# ── Off-site backups (backup service, restic - see RESTORE.md) ────────────────
# Sync is not a backup (a deletion syncs too). Each node backs itself up every
# night: database dump + DATA_DIR + documents/, encrypted, 30 daily + 12 monthly.
# Restic repository on a SEPARATE server (ideally at another provider), over SFTP.
# The SSH key and known_hosts go in ./backup/ssh/.
BACKUP_SFTP_TARGET=
# Encryption key of the repository - without it the backups are unreadable.
# Keep a copy somewhere that is NOT one of the servers.
RESTIC_PASSWORD=
# Optional second copy to a NAS directory mounted on this host, e.g. /mnt/nas/sdai
BACKUP_NAS_PATH=
# Local time of the nightly run (container TZ)
BACKUP_TIME=02:30

# Root of the repository - used to locate documents/ for OCR/VLM endpoints.
# Set automatically to /app in Docker (via Dockerfile ENV). Override for local dev
# if running the API from a subdirectory (e.g. apps/api/).
# PROJECT_ROOT=/path/to/sdai_digitalization

# ── Redis (caching) ──────────────────────────────────────────────────────────
# REQUIRED - generate with: openssl rand -hex 24
REDIS_PASSWORD=
# Local dev:  redis://:<password>@localhost:6379
# Docker:     redis://:<password>@redis:6379
REDIS_URL=redis://:@localhost:6379

# ── CORS ──────────────────────────────────────────────────────────────────────
# Local dev only - leave empty in Docker (nginx proxies internally)
CORS_ORIGINS=http://localhost:5173

# ── Ingest security ───────────────────────────────────────────────────────────
# Admins using POST /api/ingest/path can only read from this directory tree.
# Set to an absolute path on the server where document batches are staged.
INGEST_ROOT=/data/ingest

# ── Google Drive (optional) ───────────────────────────────────────────────────
# Path to a service account JSON key file with Drive read access.
# Required only when using POST /api/ingest/path with google_drive_folder_id.
GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/service-account.json

# OAuth2 credentials (if building a user-facing Drive connect flow in future)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
