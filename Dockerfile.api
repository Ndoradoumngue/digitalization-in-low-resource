FROM python:3.11-slim

WORKDIR /app

# Install dependencies first so this layer is cached on code changes
COPY requirements.api.txt .
RUN pip install --no-cache-dir -r requirements.api.txt

COPY api_server.py .

# documents/ is mounted as a read-only volume at runtime — not baked into the image
VOLUME ["/app/documents"]

EXPOSE 8000

CMD ["uvicorn", "api_server:app", "--host", "0.0.0.0", "--port", "8000"]
